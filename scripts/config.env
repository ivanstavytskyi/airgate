# Shared configuration for gateway and sandbox scripts.
# Copy the whole scripts/ folder into each VM and adjust the values below
# after checking `ip -br a` / `nmcli device status` inside the guest.

# ---------------------------------------------------------------- gateway ---
# Adapter 1 (VMware NAT) - uplink to the host / internet
WAN_IFACE="ens33"
# Adapter 2 (VMware LAN segment "sandbox-lan") - towards the sandbox VM
LAN_IFACE="ens37"
# Tunnel interface created by the VPN client
#   AmneziaVPN -> amn0      wg-quick -> wg0 (or whatever your config is named)
VPN_IFACE="amn0"
# NetworkManager connection name of the WAN adapter (see `nmcli connection show`)
WAN_CON="Wired connection 1"

# --------------------------------------------------------- internal subnet ---
LAN_SUBNET="10.10.10.0/24"
GATEWAY_IP="10.10.10.1"
CLIENT_IP="10.10.10.2"
PREFIX="24"
# Resolver used by both VMs. Sandbox queries reach it through the tunnel.
DNS="1.1.1.1"

# ---------------------------------------------------------------- sandbox ---
# The sandbox has a single adapter, on the LAN segment
CLIENT_IFACE="ens33"
CLIENT_CON="Wired connection 1"
